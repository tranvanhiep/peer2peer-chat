{
  "name": "peer2peer-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build && npm run server",
    "dev": "vite",
    "dev:server": "nodemon --exec ts-node server.ts",
    "build": "tsc && vite build",
    "server": "ts-node server.ts",
    "preview": "vite preview",
    "format": "prettier --write --log-level warn .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "dotenv": "^16.0.2",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.9.1",
    "@eslint/js": "^10.0.1",
    "@babel/core": "^7.29.7",
    "@types/express": "^5.0.6",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@types/uuid": "^8.3.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "description": "peer to peer chat app",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tranvanhiep/peer2peer-chat.git"
  },
  "keywords": [
    "peer2peer",
    "chat"
  ],
  "author": "Hiep Tran",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tranvanhiep/peer2peer-chat/issues"
  },
  "homepage": "https://github.com/tranvanhiep/peer2peer-chat#readme"
}
